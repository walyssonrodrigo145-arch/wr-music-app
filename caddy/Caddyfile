wrmusicpro.com.br {
    encode zstd gzip
    reverse_proxy app:3000
}

www.wrmusicpro.com.br {
    redir https://wrmusicpro.com.br{uri} permanent
}

escola.wrmusicpro.com.br {
    root * /srv/landpage
    file_server
}

analytics.wrmusicpro.com.br {
    # Ingestão roda no serviço independente (analytics-compose.yml).
    # Se o serviço estiver fora, o tracker faz fallback para o tRPC legado do app.
    handle /ingest/* {
        reverse_proxy analytics:3002
    }
    # Dashboard do Analytics continua no MusicPro.
    handle {
        reverse_proxy app:3000
    }
}

leads.wrmusicpro.com.br {
    reverse_proxy app:3000
}

staging.wrmusicpro.com.br {
    reverse_proxy app-staging:3000
}

dancepro.wrmusicpro.com.br {
    reverse_proxy dance-app:5000
}

wrvsystems.com.br {
    encode zstd gzip
    request_body {
        max_size 64KB
    }
    reverse_proxy wrv-site:3000 {
        header_up X-Forwarded-For {remote_host}
    }
}

www.wrvsystems.com.br {
    redir https://wrvsystems.com.br{uri} permanent
}

dancepro.wrvsystems.com.br {
    reverse_proxy dance-app:5000
}
